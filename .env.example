# Sarvam AI API Configuration
SARVAM_AI_API_KEY=your_sarvam_api_key_here

# Neo4j Graph Database (Optional - falls back to In-Memory Engine)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Engine Settings
BLAST_RADIUS_CHOKEPOINT_THRESHOLD=90.0
ENABLE_AUDIO_BROADCAST=true
DEFAULT_SPEAKER=priya
DEFAULT_LANGUAGE=hi-IN
